{
  "manifestVersion": 5,
  "id": "aistudio.premiere.panel",
  "name": "AI Studio",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiStudioPanel",
      "label": {
        "default": "AI Studio"
      },
      "minimumSize": {
        "width": 300,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 600
      }
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon-24.png",
      "scale": [1, 2],
      "theme": ["all"]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8765",
        "http://localhost:8765"
      ]
    },
    "localFileSystem": "plugin"
  }
}
